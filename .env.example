# ============ 数据存储（Turso / libsql）============
# 在 https://turso.tech 创建数据库后获得 URL 和 auth token
# 说明：Docker 部署时这些变量支持在容器运行时注入，无需在镜像构建阶段提供
TURSO_DATABASE_URL=libsql://your-db-org.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ============ 缓存失效回调（navagent 同步侧调用）============
# navagent 每日同步 Turso 后 POST /api/revalidate-nav 使进程内导航缓存立即失效，
# 未配置时该端点返回 503 关闭。生成：openssl rand -hex 32
# （服务器部署时 deploy.yml 会在 .env 缺失该键时自动生成；navagent 侧自动改名继承）
REVALIDATE_KEY=your_random_revalidate_key

# ============ 腾讯云 EdgeOne（可选，本项目密钥统一存放处）============
# navagent 同步落库后用这组凭据调 CreatePurgeTask 刷新本站边缘缓存
# （HTML s-maxage=86400 只能靠主动刷新），deploy 时会被 navagent 幂等继承。
# SecretId/Key 在腾讯云「访问管理 → API 密钥管理」创建（需 EdgeOne 刷新权限）；
# ZoneId 在 EdgeOne 控制台站点列表获取（zone- 开头）。留空则刷新功能静默关闭。
EDGEONE_SECRET_ID=
EDGEONE_SECRET_KEY=
EDGEONE_ZONE_ID=
EDGEONE_PURGE_HOST=navhub.shenzjd.com

# ============ GitHub OAuth（后台登录，M3）============
# 在 GitHub → Settings → Developer settings → OAuth Apps 创建应用后获得
# 回调 URL 填：https://<你的域名>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# session 签名密钥，≥32 字符（生成：openssl rand -base64 32）
AUTH_SECRET=your_random_secret_at_least_32_chars
# 唯一管理员 GitHub 登录名（能进入后台的账号）
ADMIN_GITHUB_LOGIN=your_github_username
